{
  "name": "voxel-isles-tools",
  "private": true,
  "type": "module",
  "description": "Dev-only build and test tools for Voxel Isles.",
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "build:web": "node build.mjs --platform=web --out=builds/web && node -e \"require('fs').copyFileSync('../LICENSES.txt', '../builds/web/LICENSES.txt')\""
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "playwright-core": "^1.63.0",
    "three": "^0.180.0"
  },
  "dependencies": {
    "@supabase/realtime-js": "2.117.0",
    "yuka": "^0.7.8"
  }
}
